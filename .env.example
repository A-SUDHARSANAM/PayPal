# Public API base URL only; do not put PayPal or Supabase service secrets here.
NEXT_PUBLIC_AGENTPAY_API_URL=<YOUR_AGENTPAY_API_URL>
# Public Supabase browser configuration only. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<YOUR_SUPABASE_SECRET_KEY>
# Production: set this to the HTTPS Render API URL in Vercel's environment settings.
